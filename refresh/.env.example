# Copy this file to refresh/.env and paste your own values. Never commit .env.
# Supabase -> Project Settings -> API: the Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase -> Project Settings -> API Keys -> SECRET key (starts with sb_secret_ or eyJ...).
# This one bypasses the access rules, so it stays on this computer only.
SUPABASE_SECRET_KEY=
